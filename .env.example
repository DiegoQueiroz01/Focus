# Copie para .env e preencha. Nunca versione o .env.

POSTGRES_DB=focus
POSTGRES_USER=focus
POSTGRES_PASSWORD=troque-esta-senha

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=1440
API_PORT=8000

# Lista JSON de origens permitidas (necessário só para Flutter Web).
# Ex.: CORS_ORIGINS=["http://localhost:5000"]
CORS_ORIGINS=[]

# Alternativa por regex. Em dev, o Flutter Web sobe em porta aleatória:
# CORS_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1):\d+$
CORS_ORIGIN_REGEX=
